GITHUB_TOKEN=replace-with-a-fine-grained-token
GITHUB_OWNER=IsraelSiq
GITHUB_REPO=bastiao-autodidata
BASTIAO_MODEL=llama3.2:3b
BASTIAO_TEMPERATURE=0.2
BASTIAO_MAX_ISSUES=1
BASTIAO_MAX_ITERATIONS=20
BASTIAO_INTERVAL_SECONDS=3600
# Optional comma-separated issue numbers; empty means automatic selection.
BASTIAO_ISSUE_NUMBERS=
# Set true only when intentionally retrying an issue with an existing PR.
BASTIAO_RETRY_ISSUES=false
# GitHub API request timeout in seconds.
BASTIAO_GITHUB_TIMEOUT_SECONDS=20
# Timeout for each quality-gate command.
BASTIAO_QUALITY_GATE_TIMEOUT_SECONDS=120
# Sandbox resource limits.
BASTIAO_COMMAND_TIMEOUT_SECONDS=60
BASTIAO_MAX_COMMANDS=100
BASTIAO_MAX_OUTPUT_CHARS=10000
BASTIAO_MAX_WRITE_BYTES=1000000
# POSIX per-command limits; the Compose service also has cgroup memory/CPU/PID caps.
BASTIAO_MEMORY_LIMIT_MB=2048
BASTIAO_CPU_LIMIT_SECONDS=45
# Container limits (the server host must have room for the 4 GiB/2 CPU agent cap).
BASTIAO_CONTAINER_MEMORY_LIMIT=4g
BASTIAO_CONTAINER_CPUS=2.0
BASTIAO_CONTAINER_PIDS_LIMIT=256
BASTIAO_REQUIRE_APPROVAL=true
BASTIAO_APPROVAL_FILE=/var/lib/bastiao/approvals.json
# Sensitive actions and GitHub publication require separate, expiring approvals.
BASTIAO_REQUIRE_ACTION_APPROVAL=true
BASTIAO_ACTION_APPROVAL_FILE=/var/lib/bastiao/action-approvals.json
BASTIAO_ACTION_AUDIT_FILE=/var/lib/bastiao/action-approval-audit.jsonl
BASTIAO_APPROVAL_REQUEST_TTL_SECONDS=86400
BASTIAO_ACTION_APPROVAL_TTL_SECONDS=3600
BASTIAO_STATE_DIR=/var/lib/bastiao
# Healthcheck probe timeout in seconds and optional ChromaDB URL.
BASTIAO_HEALTH_TIMEOUT_SECONDS=5
# Bounded retry for idempotent GitHub reads (writes are never retried).
BASTIAO_GITHUB_RETRY_ATTEMPTS=3
BASTIAO_GITHUB_RETRY_BASE_SECONDS=1
# Cycle metrics retention: rotate at this size and keep this many backups.
BASTIAO_METRICS_MAX_BYTES=5242880
BASTIAO_METRICS_BACKUPS=5
CHROMA_URL=http://127.0.0.1:8000
