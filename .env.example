GITHUB_TOKEN=replace-with-a-fine-grained-token
GITHUB_OWNER=IsraelSiq
GITHUB_REPO=bastiao-autodidata
BASTIAO_MODEL=llama3.2:3b
BASTIAO_MAX_ISSUES=1
BASTIAO_MAX_ITERATIONS=20
BASTIAO_INTERVAL_SECONDS=3600
# Optional comma-separated issue numbers; empty means automatic selection.
BASTIAO_ISSUE_NUMBERS=
# Set true only when intentionally retrying an issue with an existing PR.
BASTIAO_RETRY_ISSUES=false
# GitHub API request timeout in seconds.
BASTIAO_GITHUB_TIMEOUT_SECONDS=20
